 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    .print-format {\n        font-family: \"Inter\", \"Helvetica\", \"Arial\", sans-serif;\n        font-size: 11px;\n        color: #000 !important;\n        padding: 10px;\n        line-height: 1.4;\n    }\n\n    /* Force all text to black for clarity */\n    .print-format * {\n        color: #000 !important;\n    }\n\n    .header-section {\n        text-align: center;\n        margin-bottom: 25px;\n    }\n\n    .header-section h2 {\n        margin: 0;\n        font-weight: bold;\n        font-size: 18px;\n    }\n\n    .section-title {\n        background-color: #e8f0fe !important;\n        padding: 6px 10px;\n        font-weight: bold;\n        border: 1px solid #d1d9e6;\n        margin-top: 15px;\n        font-size: 11px;\n    }\n\n    .info-table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n\n    .info-table td {\n        padding: 8px 10px;\n        border: 1px solid #dee2e6;\n        width: 33.33%;\n        vertical-align: middle;\n    }\n\n    .label {\n        font-size: 11px;\n        text-align: left\n        display: block;\n        font-weight: bold;\n        text-transform: uppercase;\n    }\n\n    .value {\n        font-size: 11px;\n        text-align: left\n        display: block;\n        padding-left: 6px;\n    }\n\n    /* Expense Table */\n    .expense-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 5px;\n    }\n\n    .expense-table th {\n        background-color: #f1f3f5;\n        border: 1px solid #dee2e6;\n        padding: 8px;\n        text-align: left;\n        font-weight: bold;\n    }\n\n    .expense-table td {\n        border: 1px solid #dee2e6;\n        padding: 8px;\n    }\n\n    .text-right { text-align: right; }\n\n    /* Totals and Settlement */\n    .summary-container {\n        width: 100%;\n        display: flex;\n        justify-content: flex-end;\n        margin-top: 5px;\n    }\n\n    .summary-box {\n        width: 45%;\n        border-collapse: collapse;\n    }\n\n    .summary-box td {\n        border: 1px solid #dee2e6;\n        padding: 6px 10px;\n    }\n\n    .settlement-banner {\n        border: 2px solid #000;\n        padding: 12px;\n        margin-top: 15px;\n        font-weight: bold;\n        font-size: 13px;\n        background-color: #f8f9fa !important;\n    }\n\n    /* Signatures */\n    .signature-section {\n        margin-top: 50px;\n        width: 100%;\n    }\n\n    .sig-table {\n        width: 100%;\n        border: none;\n    }\n\n    .sig-table td {\n        border: none;\n        text-align: center;\n        padding-top: 40px;\n        width: 33%;\n    }\n\n    .sig-line {\n        border-top: 1px solid #000;\n        width: 80%;\n        margin: 0 auto 5px auto;\n    }\n</style>\n\n<div class=\"print-format\">\n    <div class=\"header-section\">\n        <h2>Expense Settlement Statement</h2>\n        <p>ABC Corporate Services Pvt. Ltd.</p>\n        <p style=\"font-size: 10px;\">Expense Claim Settlement Print Format Sample</p>\n    </div>\n\n    <div class=\"section-title\">1. Claim Details</div>\n    <table class=\"info-table\">\n        <tr>\n            <td><span class=\"label\">Claim ID</span><div class=\"value\">{{ doc.name }}</div></td>\n            <td><span class=\"label\">Claim Date</span><div class=\"value\">{{ doc.get_formatted(\"creation\") }}</div></td>\n            <td><span class=\"label\">Status</span><div class=\"value\">{{ doc.status }}</div></td>\n        </tr>\n        <tr>\n            <td><span class=\"label\">Branch</span><div class=\"value\">{{ doc.branch or '' }}</div></td>\n            <td><span class=\"label\">Department</span><div class=\"value\">{{ doc.department or '' }}</div></td>\n            <td>\n    <span class=\"label\">Settlement Type</span>\n    <div class=\"value\">\n        {% if doc.balance_payable > 0 %}\n            Amount Payable\n        {% elif doc.balance_receivable > 0 %}\n            Amount Receivable\n        {% else %}\n            Settled\n        {% endif %}\n    </div>\n</td>\n        </tr>\n    </table>\n\n    <div class=\"section-title\">2. Employee Details</div>\n    <table class=\"info-table\">\n        <tr>\n            <td><span class=\"label\">Employee</span><div class=\"value\">{{ doc.employee_id }}</div></td>\n            <td><span class=\"label\">Designation</span><div class=\"value\">{{ doc.designation or '' }}</div></td>\n            <td><span class=\"label\">Reporting Manager</span><div class=\"value\">{{ doc.reporting_manager_name or '' }}</div></td>\n        </tr>\n        <tr>\n            <td><span class=\"label\">Department</span><div class=\"value\">{{ doc.department or '' }}</div></td>\n            <td><span class=\"label\">Branch</span><div class=\"value\">{{ doc.branch or '' }}</div></td>\n            <td><span class=\"label\">Email</span><div class=\"value\">{{ doc.email or '' }}</div></td>\n        </tr>\n    </table>\n\n    <div class=\"section-title\">3. Linked Travel Request</div>\n    <table class=\"info-table\">\n        <tr>\n            <td><span class=\"label\">Travel Request ID</span><div class=\"value\">{{ doc.travel_request or 'N/A' }}</div></td>\n            <td><span class=\"label\">Purpose</span><div class=\"value\">{{ doc.purpose or '' }}</div></td>\n            <td><span class=\"label\">From Location</span><div class=\"value\">{{ doc.from_location or '' }}</div></td>\n        </tr>\n        <tr>\n            <td><span class=\"label\">To Location</span><div class=\"value\">{{ doc.to_location or '' }}</div></td>\n            <td><span class=\"label\">Start Date</span><div class=\"value\">{{ doc.get_formatted(\"start_date\") or '' }}</div></td>\n            <td><span class=\"label\">End Date</span><div class=\"value\">{{ doc.get_formatted(\"end_date\") or '' }}</div></td>\n        </tr>\n    </table>\n\n    <div class=\"section-title\">4. Expense Summary</div>\n    <table class=\"expense-table\">\n        <thead>\n            <tr>\n                <th style=\"width: 15%;\">Date</th>\n                <th style=\"width: 20%;\">Category</th>\n                <th style=\"width: 35%;\">Description</th>\n                <th style=\"width: 15%; text-align: right;\">Claimed</th>\n                <th style=\"width: 15%; text-align: right;\">Approved</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.expense_details %}\n            <tr>\n                <td>{{ row.get_formatted(\"date\") or '' }}</td>\n                <td>{{ row.category or '' }}</td>\n                <td>{{ row.description or '' }}</td>\n                <td class=\"text-right\">{{ doc.get_formatted(\"amount\", row) }}</td>\n                <td class=\"text-right\">{{ doc.get_formatted(\"approve_amount\", row) }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n\n    <div class=\"summary-container\">\n        <table class=\"summary-box\">\n            <tr>\n                <td style=\"font-weight: bold;\">Total Claimed Amount</td>\n                <td class=\"text-right\">{{ doc.get_formatted(\"total_claimed_amount\") }}</td>\n            </tr>\n            <tr style=\"background-color: #f8f9fa !important;\">\n                <td style=\"font-weight: bold;\">Total Approved Amount</td>\n                <td class=\"text-right\">{{ doc.get_formatted(\"total_approved_amount\") }}</td>\n            </tr>\n        </table>\n    </div>\n\n    <div class=\"section-title\">5. Advance and Settlement</div>\n    <table class=\"info-table\">\n        <tr>\n            <td><span class=\"label\">Advance Taken</span><div class=\"value\">{{ doc.get_formatted(\"advance_taken\") }}</div></td>\n            <td><span class=\"label\">Total Approved Expense</span><div class=\"value\">{{ doc.get_formatted(\"total_approved_expense\") }}</div></td>\n            <td><span class=\"label\">Net Settlement</span><div class=\"value\">\n                {% if doc.balance_payable > 0 %}\n                    Balance Payable: {{ doc.get_formatted(\"balance_payable\") }}\n                {% elif doc.balance_receivable > 0 %}\n                    Balance Receivable: {{ doc.get_formatted(\"balance_receivable\") }}\n                {% else %}\n                    Settlement Completed: {{ doc.get_formatted(\"total_approved_amount\") }}\n                {% endif %}\n            </div></td>\n        </tr>\n    </table>\n    <div class=\"settlement-banner\">\n        {% if doc.balance_payable > 0 %}\n            Balance Payable to Employee: {{ doc.get_formatted(\"balance_payable\") }}\n        {% elif doc.balance_receivable > 0 %}\n            Balance Receivable from Employee: {{ doc.get_formatted(\"balance_receivable\") }}\n        {% else %}\n            Settlement Completed: {{ doc.get_formatted(\"total_approved_amount\") }}\n        {% endif %}\n    </div>\n\n    <div class=\"section-title\">6. Finance Verification</div>\n    <table class=\"info-table\">\n        <tr>\n            <td style=\"width: 40%;\"><span class=\"label\">Finance Remarks</span><div class=\"value\">{{ doc.finance_remarks or 'Verified against policy' }}</div></td>\n            <td><span class=\"label\">Verified By</span><div class=\"value\">{{ doc.verified_by or '' }}</div></td>\n            <td><span class=\"label\">Verified On</span><div class=\"value\">{{ doc.get_formatted(\"verified_date\") or '' }}</div></td>\n        </tr>\n    </table>\n\n    <div class=\"section-title\">7. Approval Section</div>\n    <table class=\"info-table\">\n        <tr>\n            <td><span class=\"label\">Approved By</span><div class=\"value\">{{ doc.final_approved_by or '' }}</div></td>\n            <td><span class=\"label\">Approval Date</span><div class=\"value\">{{ doc.get_formatted(\"final_approval_date\") or '' }}</div></td>\n            <td><span class=\"label\">Approver Remarks</span><div class=\"value\">{{ doc.approver_remarks or 'Verified against policy'}}</div></td>\n        </tr>\n    </table>\n\n    <div class=\"section-title\">8. Declaration</div>\n    <p style=\"margin-top: 10px;\">I hereby confirm that the above expenses were incurred for official business purposes and the information provided in this statement is true to the best of my knowledge.</p>\n\n    <div class=\"signature-section\">\n        <table class=\"sig-table\">\n            <tr>\n                <td><div class=\"sig-line\"></div>Employee Signature</td>\n                <td><div class=\"sig-line\"></div>Finance Signature</td>\n                <td><div class=\"sig-line\"></div>Approver Signature</td>\n            </tr>\n        </table>\n    </div>\n</div>",
