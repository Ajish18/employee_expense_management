 "html": "<style>\n@page {\n    size: A4;\n    margin: 10mm;\n}\n\nbody {\n    font-family: Arial;\n    font-size: 12px;\n}\n\n.title {\n    text-align: center;\n    font-size: 16px;\n    font-weight: bold;\n    margin-bottom: 10px;\n}\n\n.section {\n    background: #d9e2f3;\n    padding: 5px;\n    border: 1px solid #999;\n    font-weight: bold;\n    margin-top: 10px;\n}\n\n.table {\n    width: 100%;\n    border-collapse: collapse;\n}\n\n.table td, .table th {\n    border: 1px solid #999;\n    padding: 5px;\n}\n\n.label {\n    font-weight: bold;\n}\n\n.text-right {\n    text-align: right;\n}\n\n.center {\n    text-align: center;\n}\n\n.signature td {\n    border: none;\n    padding-top: 40px;\n}\n</style>\n\n<div class=\"title\">Expense Settlement Statement</div>\n\n<!-- 1 Employee -->\n<div class=\"section\">1. Employee Details</div>\n<table class=\"table\">\n<tr>\n<td><span class=\"label\">Employee ID</span><br>{{ doc.employee_id }}</td>\n<td><span class=\"label\">Designation</span><br>{{ doc.designation }}</td>\n<td><span class=\"label\">Department</span><br>{{ doc.department }}</td>\n</tr>\n\n<tr>\n<td><span class=\"label\">Email</span><br>{{ doc.email }}</td>\n<td><span class=\"label\">Phone</span><br>{{ doc.phone }}</td>\n<td><span class=\"label\">Branch</span><br>{{ doc.branch }}</td>\n</tr>\n\n<tr>\n<td colspan=\"3\"><span class=\"label\">Reporting Manager</span><br>{{ doc.reporting_manager_name }}</td>\n</tr>\n</table>\n\n<!-- 2 Travel -->\n<div class=\"section\">2. Travel Details</div>\n<table class=\"table\">\n<tr>\n<td><span class=\"label\">Travel Request</span><br>{{ doc.travel_request }}</td>\n<td><span class=\"label\">Purpose</span><br>{{ doc.purpose }}</td>\n</tr>\n\n<tr>\n<td><span class=\"label\">From</span><br>{{ doc.from_location }}</td>\n<td><span class=\"label\">To</span><br>{{ doc.to_location }}</td>\n</tr>\n\n<tr>\n<td><span class=\"label\">Start Date</span><br>{{ doc.start_date }}</td>\n<td><span class=\"label\">End Date</span><br>{{ doc.end_date }}</td>\n</tr>\n</table>\n\n<!-- 3 Expense -->\n<div class=\"section\">3. Expense Summary</div>\n<table class=\"table\">\n<tr>\n<th>Date</th>\n<th>Category</th>\n<th>Description</th>\n<th>Claimed</th>\n<th>Approved</th>\n</tr>\n\n{% for row in doc.expense_details %}\n<tr>\n<td>{{ row.date }}</td>\n<td>{{ row.category }}</td>\n<td>{{ row.description or \"\" }}</td>\n<td class=\"text-right\">{{ row.amount }}</td>\n<td class=\"text-right\">{{ row.approve_amount }}</td>\n</tr>\n{% endfor %}\n\n<tr>\n<td colspan=\"3\" class=\"text-right\"><b>Total Claimed</b></td>\n<td class=\"text-right\">{{ doc.total_claimed_amount }}</td>\n<td></td>\n</tr>\n\n<tr>\n<td colspan=\"4\" class=\"text-right\"><b>Total Approved</b></td>\n<td class=\"text-right\">{{ doc.total_approved_amount }}</td>\n</tr>\n</table>\n\n<!-- 4 Advance -->\n<div class=\"section\">4. Advance & Settlement</div>\n<table class=\"table\">\n<tr>\n<td><span class=\"label\">Advance Taken</span><br>{{ doc.advance_taken }}</td>\n<td><span class=\"label\">Total Approved Expense</span><br>{{ doc.total_approved_expense }}</td>\n</tr>\n\n<tr>\n<td><span class=\"label\">Balance Payable</span><br>{{ doc.balance_payable }}</td>\n<td><span class=\"label\">Balance Receivable</span><br>{{ doc.balance_receivable }}</td>\n</tr>\n</table>\n\n<p><b>Net Settlement:</b>\n{% if doc.balance_payable %}\nPayable to Employee: {{ doc.balance_payable }}\n{% elif doc.balance_receivable %}\nReceivable from Employee: {{ doc.balance_receivable }}\n{% else %}\nNil\n{% endif %}\n</p>\n\n<!-- 5 Finance Verification (NO REMARKS) -->\n<div class=\"section\">5. Finance Verification</div>\n<table class=\"table\">\n<tr>\n<td><span class=\"label\">Verified By</span><br>{{ doc.verified_by }}</td>\n<td><span class=\"label\">Date</span><br>{{ doc.verified_date }}</td>\n</tr>\n</table>\n\n<!-- 6 Approval -->\n<div class=\"section\">6. Approval</div>\n<table class=\"table\">\n<tr>\n<td><span class=\"label\">Approved By</span><br>{{ doc.final_approved_by }}</td>\n<td><span class=\"label\">Date</span><br>{{ doc.final_approval_date }}</td>\n</tr>\n</table>\n\n<!-- Signature -->\n<table class=\"signature\" style=\"width:100%;\">\n<tr>\n<td class=\"center\">Employee Signature</td>\n<td class=\"center\">Finance User Signature</td>\n<td class=\"center\">Finance Manager Signature</td>\n</tr>\n</table>",
