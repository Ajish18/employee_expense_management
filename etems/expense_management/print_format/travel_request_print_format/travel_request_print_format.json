 "font_size": 14,
 "html": "<style>\n    body {\n        font-family: Arial;\n        font-size: 12px;\n    }\n\n    .title {\n        text-align: center;\n        font-size: 20px;\n        font-weight: bold;\n        margin-bottom: 10px;\n    }\n\n    table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 10px;\n    }\n\n    td {\n        border: 1px solid #000;\n        padding: 6px;\n    }\n\n    .section {\n        background: #000;\n        color: #fff;\n        font-weight: bold;\n        text-align: left;\n    }\n\n    .no-border td {\n        border: none;\n    }\n\n    \n</style>\n\n<div class=\"title\">TRAVEL REQUEST</div>\n\n<!-- Header -->\n<table class=\"no-border\">\n    <tr>\n        <td><b>Request ID:</b> {{ doc.name }}</td>\n        <td><b>Date:</b> {{ frappe.utils.formatdate(doc.creation) }}</td>\n    </tr>\n</table>\n\n<!-- Employee Details -->\n<table>\n    <tr class=\"section\"><td colspan=\"2\">Employee Details</td></tr>\n\n    <tr>\n        <td><b>Name:</b> {{ doc.employee_name }}</td>\n        <td><b>Employee ID:</b> {{ doc.employee_id }}</td>\n    </tr>\n\n    <tr>\n        <td><b>Branch:</b> {{ doc.branch }}</td>\n        <td><b>Department:</b> {{ doc.department }}</td>\n    </tr>\n</table>\n\n<!-- Travel Details -->\n<table>\n    <tr class=\"section\"><td colspan=\"2\">Travel Details</td></tr>\n\n    <tr>\n        <td colspan=\"2\"><b>Purpose:</b> {{ doc.purpose }}</td>\n    </tr>\n\n    <tr>\n        <td><b>From:</b> {{ doc.from_location }}</td>\n        <td><b>To:</b> {{ doc.to_location }}</td>\n    </tr>\n\n    <tr>\n        <td><b>Start Date:</b> {{ doc.start_date or \"-\" }}</td>\n        <td><b>End Date:</b> {{ doc.end_date or \"-\" }}</td>\n    </tr>\n</table>\n\n<!-- Financial -->\n<table>\n    <tr class=\"section\"><td colspan=\"2\">Financial Details</td></tr>\n\n    <tr>\n        <td><b>Estimated Cost:</b> \u20b9 {{ doc.estimated_cost or 0 }}</td>\n        <td><b>Advance Amount:</b> \u20b9 {{ doc.advance_amount or 0 }}</td>\n    </tr>\n\n    <tr>\n        <td colspan=\"2\"><b>Status:</b> {{ doc.status }}</td>\n    </tr>\n</table>\n\n<!-- Itinerary Table -->\n{% if doc.travel_itinerary %}\n<table>\n    <tr class=\"section\">\n        <td>No</td>\n        <td>Date</td>\n        <td>From</td>\n        <td>To</td>\n        <td>Mode</td>\n        <td>Amount</td>\n    </tr>\n\n    {% for row in doc.travel_itinerary %}\n    <tr>\n        <td>{{ loop.index }}</td>\n        <td>{{ row.date }}</td>\n        <td>{{ row.from_location }}</td>\n        <td>{{ row.to_location }}</td>\n        <td>{{ row.mode_of_travel }}</td>\n        <td>{{ row.expected_amount }}</td>\n    </tr>\n    {% endfor %}\n</table>\n{% endif %}\n\n<div style=\"margin-top:60px;\">\n\n    <p style=\"display:inline-block; width:32%; text-align:left;\">\n        Employee Sign\n    </p>\n\n    <p style=\"display:inline-block; width:32%; text-align:center;\">\n        Reporting Manager Sign\n    </p>\n\n    <p style=\"display:inline-block; width:32%; text-align:right;\">\n        Finance Manager Sign\n    </p>\n\n</div>",
